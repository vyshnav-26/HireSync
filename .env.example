# =================================================================
# HireSync Local Development Environment Variables
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# =================================================================

# -----------------------------------------------------------------
# General & Application Settings
# -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# -----------------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------------
POSTGRES_DB=hiresync
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------
# MinIO (S3-compatible Object Storage) Configuration
# -----------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=hiresync-resumes

# -----------------------------------------------------------------
# Security & JWT Configuration
# (Generate a 256-bit+ secure random secret in production)
# -----------------------------------------------------------------
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
